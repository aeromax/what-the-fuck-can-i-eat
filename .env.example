# Copy to .env for local `npm run refresh` runs.
#
# Passed to GoogleGenAI explicitly in scripts/voice.ts — the @google/genai README
# says the auto-detected variable is GOOGLE_API_KEY while the maintainers' codegen
# guide says GEMINI_API_KEY, so neither is trusted to be picked up implicitly.
#
# Never rename this with a PUBLIC_ prefix.
GEMINI_API_KEY=
