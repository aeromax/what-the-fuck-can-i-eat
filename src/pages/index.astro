---
import { readFileSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { z } from 'zod';
import RecallRow from '../components/Recall.astro';
import { RecallSchema, type Recall } from '../recall.ts';
import { MetaSchema, type MetaFile } from '../meta.ts';
import { ReviewEntrySchema } from '../../scripts/merge.ts';
import type { ReviewEntry } from '../../scripts/merge.ts';
import rawRecalls from '../../data/recalls.json';
import rawReview from '../../data/review.json';

// The whole point of this page is a four-second read while someone is holding a
// product. The frame does the naming, ordering, and honesty; the row component
// carries the hazard tag, the confidence tag, and the actionable avoid-line.
//
// Load-order note: everything below runs at build time. `readFileSync` is
// deliberate for meta.json — the preview state does not have one yet, and a
// plain `import` would fail the whole build the first time someone tries to
// preview before step 8 has ever run.

// --- data plumbing ----------------------------------------------------------

// Validate on the way in: a malformed data file should fail the build rather
// than render half a page of wrong facts (docs/design.md §2).
const recalls: Recall[] = z.array(RecallSchema).parse(rawRecalls);
const review: ReviewEntry[] = z.array(ReviewEntrySchema).parse(rawReview);

// Resolved against the project root, not `import.meta.url`. Vite rewrites a page
// module's own URL to point inside the temporary SSR build output, so a relative
// URL from here silently resolves to a path that does not exist and every read
// falls into the catch — the footer then claims "no refresh recorded yet" on a
// site that refreshed ten minutes ago. Astro always runs from the project root.
const dataDir = join(process.cwd(), 'data');
const recallsPath = join(dataDir, 'recalls.json');
const metaPath = join(dataDir, 'meta.json');

/** meta.json only exists after refresh.ts has run once. In the preview state it
 * is missing, and the page must still render — with an honest empty shape. */
function loadMeta(): MetaFile | null {
  try {
    return MetaSchema.parse(JSON.parse(readFileSync(metaPath, 'utf8')));
  } catch {
    return null;
  }
}

/** The file's own mtime is the "last checked" timestamp — refresh.ts deliberately
 * does not write one into meta.json (would tick every run and defeat the
 * byte-identical rule). See scripts/refresh.ts. */
function lastCheckedInstant(): Date | null {
  try {
    return statSync(recallsPath).mtime;
  } catch {
    return null;
  }
}

const meta = loadMeta();
const lastChecked = lastCheckedInstant();

// --- presentation helpers ---------------------------------------------------

const DATE_ET = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
const TIME_ET = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  hour: 'numeric',
  minute: '2-digit',
});
const ZONE_ET = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  timeZoneName: 'short',
});

function formatEasternInstant(at: Date): { day: string; time: string; zone: string } {
  const zone = ZONE_ET.formatToParts(at).find((p) => p.type === 'timeZoneName')?.value ?? 'ET';
  return { day: DATE_ET.format(at), time: TIME_ET.format(at), zone };
}

// Order is newest announcement first, as merge.ts already sorted it — NOT
// verified-then-extracted. Grouping by tier would bury the extracted rows, and
// those are the freshest items on the page (FDA grades a recall weeks after the
// press release, docs/design.md §7) and therefore the ones most likely to still
// be on a shelf. The confidence distinction is carried per row by Recall.astro's
// band and eyebrow instead, where it sits next to the claim it qualifies.
const stamp = lastChecked ? formatEasternInstant(lastChecked) : null;
const awaitingVoice = recalls.filter((r) => r.headline === null).length;
const verifiedCount = recalls.filter((r) => r.confidence === 'verified').length;
const extractedCount = recalls.length - verifiedCount;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>what the fuck can i eat</title>
    <meta name="description" content="US food recalls active right now, in plain English." />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <a class="skip" href="#list">Skip to recalls</a>

    <main>
      <header class="masthead">
        <h1 aria-label="what the fuck can i eat">
          <span class="half ask">
            <span class="word">what</span>
            <span class="word">the</span>
            <span class="word accent">fuck</span>
          </span>
          <span class="half answer">
            <span class="word">can</span>
            <span class="word">i</span>
            <span class="word">eat</span>
          </span>
        </h1>

        <p class="thesis">
          Recalls and alerts active right now. Brand, product, reason and dates
          are the government's own words, from the page linked on every row. The
          headline and the short name are model-written, and the row says which
          rows had their details read out of prose rather than a database column.
        </p>

        <dl class="counts" aria-label="Summary">
          <div>
            <dt>Active</dt>
            <dd><strong>{recalls.length}</strong> recalls and alerts</dd>
          </div>
          <div>
            <dt>Verified</dt>
            <dd><strong>{verifiedCount}</strong> from structured columns</dd>
          </div>
          <div>
            <dt>Extracted</dt>
            <dd><strong>{extractedCount}</strong> from press-release prose</dd>
          </div>
        </dl>
      </header>

      <section id="list" class="list" aria-label="Active recalls">
        {recalls.length === 0 ? (
          <p class="empty">
            No records to show. If you just cloned this and are running the
            preview, run <code>npm run seed</code> or <code>npm run refresh</code>.
          </p>
        ) : (
          recalls.map((recall) => <RecallRow recall={recall} />)
        )}
      </section>

      {review.length > 0 && (
        <section class="review" aria-labelledby="review-heading">
          <p class="eyebrow" id="review-heading">
            Possibly the same recall &mdash; flagged, not merged
          </p>
          <p class="review-note">
            The pipeline could not decide whether these are one recall reported
            by two agencies or two separate ones. The safer answer is to show
            both, since a wrong merge would attach the wrong lot codes to the
            wrong product.
          </p>
          {review.map((pair) => (
            <div class="pair">
              <p class="pair-why"><span class="pair-label">Flagged:</span> {pair.why}</p>
              {pair.records.map((recall) => <RecallRow recall={recall} />)}
            </div>
          ))}
        </section>
      )}

      <footer class="site">
        <p class="eyebrow">Sources checked</p>
        {stamp ? (
          <p class="stamp">
            <span class="stamp-day">{stamp.day}</span>
            <span class="stamp-dot" aria-hidden="true">&middot;</span>
            <span class="stamp-time">{stamp.time} {stamp.zone}</span>
          </p>
        ) : (
          <p class="stamp stamp-none">No refresh recorded yet.</p>
        )}

        {meta ? (
          <ul class="sources">
            {meta.sources.map((s) => (
              <li class:list={['src', s.reachable ? 'on' : 'off']}>
                <span class="src-name">{s.name}</span>
                <span class="src-status" aria-hidden="true">{s.reachable ? '●' : '○'}</span>
                <span class="src-note">
                  {s.reachable ? `reached, ${s.count} record${s.count === 1 ? '' : 's'}` : s.note}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="sources-none">
            Source reachability will appear here after the first pipeline run.
          </p>
        )}

        <p class="colophon">
          {awaitingVoice > 0 && (
            <span>{awaitingVoice} row{awaitingVoice === 1 ? '' : 's'} still awaiting voice &mdash; the government reason is shown instead. </span>
          )}
          Class III recalls are excluded as the boring tier. Human food only.
          A <em>Public Health Alert</em> is not a recall &mdash; FSIS issues one
          when contaminated product is believed to be on shelves but no recall
          has been requested.
        </p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  /* --- tokens ------------------------------------------------------------ */
  :root {
    --bg: #f4f1ea;
    --paper: #fbf9f3;
    --ink: #16130f;
    --dim: #6b665c;
    --rule: #d9d3c4;
    --field: #ede9dd;
    --alarm: #a4241c;
    --serif: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Palatino, Georgia, serif;
    --sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'JetBrains Mono', Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12110e;
      --paper: #18161200;
      --ink: #ede8d9;
      --dim: #8a8578;
      --rule: #2b2822;
      --field: #1c1a15;
      --alarm: #e26b62;
    }
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 var(--sans);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  /* Keyboard skip-link — hidden until focused. */
  .skip {
    position: absolute; left: -9999px; top: 0;
    background: var(--ink); color: var(--bg);
    padding: 0.5rem 0.75rem; font: 600 0.85rem/1 var(--mono);
  }
  .skip:focus { left: 0.5rem; top: 0.5rem; z-index: 10; }

  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }

  /* --- masthead ---------------------------------------------------------- */
  .masthead {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1.25rem;
  }
  h1 {
    /* The signature: the title as a monospaced banner, split in two across a
       hairline spine — the swearing on one side, the question on the other.
       The layout carries the tone; nothing else on the page has to. */
    font: 800 clamp(2rem, 8.5vw, 4.25rem)/0.92 var(--mono);
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--ink);
    display: flex;
    align-items: stretch;
    gap: 0;
    /* Content-width, so the rule is exactly as long as the words it divides —
       and, once the axis rotates on a phone, no longer than them either. */
    width: fit-content;
  }
  .half {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  /* Both halves press against the spine, so the rule reads as the axis of the
     composition rather than as a divider that happens to sit between them. */
  .ask {
    text-align: right;
    padding-right: clamp(0.6rem, 2.5vw, 1.25rem);
  }
  .answer {
    text-align: left;
    padding-left: clamp(0.6rem, 2.5vw, 1.25rem);
    /* Same weight and style as the band down the left of each recall row, so the
       page reads as one system. Neutral colour: unlike a row's band, the title
       has no severity to encode. */
    border-left: 4px solid var(--rule);
  }
  .word { display: block; }
  .accent { color: var(--alarm); }

  .thesis {
    margin: 1.5rem 0 0;
    font: 400 1.0625rem/1.55 var(--serif);
    font-style: italic;
    color: var(--dim);
    max-width: 34rem;
  }

  .counts {
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem 1.5rem;
    border-top: 1px dashed var(--rule);
    padding-top: 1.25rem;
  }
  .counts > div { margin: 0; }
  .counts dt {
    font: 600 0.7rem/1.2 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 0.15rem;
  }
  .counts dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .counts strong {
    font: 700 1.4rem/1 var(--mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-right: 0.3rem;
  }

  /* --- list -------------------------------------------------------------- */
  /* Recall.astro owns the row entirely — its padding, its rules, its band. The
     page deliberately sets no `.recall` rules: both stylesheets would land at
     the same specificity and whichever Astro emitted last would win, which is
     not a contract worth having. */
  .list { margin: 0; }
  .empty {
    padding: 3rem 0;
    color: var(--dim);
    font-style: italic;
    text-align: center;
  }
  code {
    font: inherit;
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--field);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }

  /* --- review pairs ------------------------------------------------------ */
  .review {
    margin: 2.5rem 0 0;
    padding: 1.5rem 0 0.25rem;
    border-top: 1px solid var(--rule);
  }
  .review-note {
    margin: 0.5rem 0 1.5rem;
    font: 400 0.95rem/1.55 var(--serif);
    font-style: italic;
    color: var(--dim);
    max-width: 34rem;
  }
  .pair {
    /* The bracket. The review pair reads as one held-together unit. The tint
       and the rules do that work; the left edge is left alone, because the row
       component already spends that edge on severity and confidence. */
    padding: 0.75rem 1rem 0.25rem;
    margin: 0 0 1.75rem;
    background: var(--field);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    border-radius: 3px;
  }
  .pair-why {
    margin: 0 0 0.25rem;
    font: 600 0.75rem/1.4 var(--mono);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--alarm);
  }
  .pair-label { opacity: 0.75; margin-right: 0.35em; }

  /* --- eyebrows (shared) ------------------------------------------------- */
  .eyebrow {
    margin: 0;
    font: 600 0.72rem/1.3 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* --- footer ------------------------------------------------------------ */
  footer.site {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    color: var(--dim);
    font-size: 0.9rem;
  }
  .stamp {
    margin: 0.4rem 0 1.5rem;
    font: 500 0.95rem/1.4 var(--mono);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .stamp-dot { margin: 0 0.5rem; color: var(--dim); }
  .stamp-none { color: var(--dim); font-weight: 400; font-style: italic; }

  .sources {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .src {
    display: grid;
    grid-template-columns: 5.5rem 1rem 1fr;
    gap: 0.5rem;
    align-items: baseline;
    font: 500 0.85rem/1.5 var(--mono);
  }
  .src-name { color: var(--ink); letter-spacing: 0.01em; }
  .src-status { text-align: center; font-size: 0.9em; }
  .src.on .src-status { color: #2f7a3a; }
  .src.off .src-status { color: var(--alarm); }
  .src-note { color: var(--dim); font-family: var(--sans); font-size: 0.85rem; font-weight: 400; }
  .src.off .src-note { color: var(--alarm); }

  .sources-none {
    margin: 0.4rem 0 1.5rem;
    font-style: italic;
    color: var(--dim);
  }

  .colophon {
    margin: 0;
    font: 400 0.85rem/1.55 var(--serif);
    color: var(--dim);
    max-width: 34rem;
  }
  .colophon em { font-style: italic; color: var(--ink); }

  /* Narrow: the spine turns horizontal and the halves stack. Side-by-side, a
     phone would have to shrink the type to about a third of its size to fit
     two mono columns — which is the one thing this page cannot afford, since
     it is meant to read at arm's length. The rule survives the rotation, so
     the two-part composition still reads; only its axis changes. */
  @media (max-width: 30rem) {
    main { padding: 1.75rem 1rem 3rem; }
    h1 {
      flex-direction: column;
      align-items: flex-start;
      font-size: clamp(2.75rem, 13.5vw, 4rem);
    }
    .ask {
      text-align: left;
      padding-right: 0;
      padding-bottom: 0.5rem;
    }
    .answer {
      padding-left: 0;
      padding-top: 0.5rem;
      border-left: none;
      border-top: 4px solid var(--rule);
      align-self: stretch;
    }
    .src { grid-template-columns: 4.5rem 1rem 1fr; }
  }
</style>
