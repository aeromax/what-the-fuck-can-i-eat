---
import { readFileSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { z } from 'zod';
import RecallRow from '../components/Recall.astro';
import { RecallSchema, type Recall } from '../recall.ts';
import { MetaSchema, type MetaFile } from '../meta.ts';
import { ReviewEntrySchema } from '../../scripts/merge.ts';
import type { ReviewEntry } from '../../scripts/merge.ts';
import rawRecalls from '../../data/recalls.json';
import rawReview from '../../data/review.json';

// The whole point of this page is a four-second read while someone is holding a
// product. The frame does the naming, ordering, and honesty; the row component
// carries the hazard tag, the confidence tag, and the actionable avoid-line.
//
// Load-order note: everything below runs at build time. `readFileSync` is
// deliberate for meta.json — the preview state does not have one yet, and a
// plain `import` would fail the whole build the first time someone tries to
// preview before step 8 has ever run.

// --- data plumbing ----------------------------------------------------------

// Validate on the way in: a malformed data file should fail the build rather
// than render half a page of wrong facts (docs/design.md §2).
const recalls: Recall[] = z.array(RecallSchema).parse(rawRecalls);
const review: ReviewEntry[] = z.array(ReviewEntrySchema).parse(rawReview);

// Resolved against the project root, not `import.meta.url`. Vite rewrites a page
// module's own URL to point inside the temporary SSR build output, so a relative
// URL from here silently resolves to a path that does not exist and every read
// falls into the catch — the footer then claims "no refresh recorded yet" on a
// site that refreshed ten minutes ago. Astro always runs from the project root.
const dataDir = join(process.cwd(), 'data');
const recallsPath = join(dataDir, 'recalls.json');
const metaPath = join(dataDir, 'meta.json');

/** meta.json only exists after refresh.ts has run once. In the preview state it
 * is missing, and the page must still render — with an honest empty shape. */
function loadMeta(): MetaFile | null {
  try {
    return MetaSchema.parse(JSON.parse(readFileSync(metaPath, 'utf8')));
  } catch {
    return null;
  }
}

/** The file's own mtime is the "last checked" timestamp — refresh.ts deliberately
 * does not write one into meta.json (would tick every run and defeat the
 * byte-identical rule). See scripts/refresh.ts. */
function lastCheckedInstant(): Date | null {
  try {
    return statSync(recallsPath).mtime;
  } catch {
    return null;
  }
}

const meta = loadMeta();
const lastChecked = lastCheckedInstant();

// --- presentation helpers ---------------------------------------------------

const DATE_ET = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
const TIME_ET = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  hour: 'numeric',
  minute: '2-digit',
});
const ZONE_ET = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  timeZoneName: 'short',
});

function formatEasternInstant(at: Date): { day: string; time: string; zone: string } {
  const zone = ZONE_ET.formatToParts(at).find((p) => p.type === 'timeZoneName')?.value ?? 'ET';
  return { day: DATE_ET.format(at), time: TIME_ET.format(at), zone };
}

// Order is newest announcement first, as merge.ts already sorted it — NOT
// verified-then-extracted. Grouping by tier would bury the extracted rows, and
// those are the freshest items on the page (FDA grades a recall weeks after the
// press release, docs/design.md §7) and therefore the ones most likely to still
// be on a shelf. The confidence distinction is carried per row by Recall.astro's
// left band, and by the tier tag inside the row, where it sits next to the
// claim it qualifies.
const stamp = lastChecked ? formatEasternInstant(lastChecked) : null;
const awaitingVoice = recalls.filter((r) => r.headline === null).length;

// Which `displayName`s are shared by more than one row.
//
// This is the §2.1 hazard showing up in live data rather than in theory. There
// are no duplicate records — no two rows share a `product` or a `sourceUrl` —
// but 16 rows share 6 model-written names: five distinct Clover Hill Dairy
// cheeses are all called "cheese". Since 9f the collapsed row shows only the
// name, so those rows became indistinguishable.
//
// The fix belongs here rather than in merge.ts. Those 18 Clover Hill rows are
// one Listeria event with one lot code across 18 different SKUs, and merging
// them on a shared lot code is precisely the wrong-merge pattern step 6
// calibration found and fixed — a lot code that identifies a firm, not a
// product. merge.ts is right; the presentation was wrong.
const nameCounts = new Map<string, number>();
for (const r of recalls) {
  if (r.displayName !== null) nameCounts.set(r.displayName, (nameCounts.get(r.displayName) ?? 0) + 1);
}
const sharedNames = new Set([...nameCounts].filter(([, n]) => n > 1).map(([name]) => name));
const isAmbiguous = (r: Recall) => r.displayName !== null && sharedNames.has(r.displayName);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>what the fuck can i eat</title>
    <meta name="description" content="US food recalls active right now, in plain English." />
    <meta name="robots" content="noindex" />

    <!-- Bebas Neue (display) / Lora (body + snark) / JetBrains Mono (utility).
         Only the faces and weights the CSS actually asks for: Bebas has a single
         weight; Lora needs regular and italic at 400; JetBrains Mono needs 400
         and 600. Nothing here requests a weight the page does not set, so the
         browser never synthesizes one and never downloads a file nothing uses.
         `display=swap` so a slow font never blanks the text. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@400;600&family=Lora:ital@0;1&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#list">Skip to recalls</a>

    <main>
      <header class="masthead">
        <h1 aria-label="what the fuck can i eat">
          <span class="line">what the <span class="accent">fuck</span></span>
          <span class="line">can i eat</span>
        </h1>

        <p class="subhead">Whatever you want! Except for the following:</p>

        <div class="strip">
          <dl class="counts" aria-label="Summary">
            <div>
              <dt>Active</dt>
              <dd><strong>{recalls.length}</strong> recalls and alerts</dd>
            </div>
          </dl>

          {/* Hidden until the script reveals it. A no-JS reader never sees a
              dead button, and the served list order is already the default
              sort, so nothing is missing without JavaScript. */}
          <div class="controls" id="sort" hidden>
            <span class="controls-label" id="sort-label">Sort by</span>
            <span class="seg" role="group" aria-labelledby="sort-label">
              <button type="button" class="sortbtn" data-sort="date" aria-pressed="true">
                <span class="sortbtn-text">Date</span>
                <span class="dir" aria-hidden="true">&darr;</span>
              </button>
              <button type="button" class="sortbtn" data-sort="severity" aria-pressed="false">
                <span class="sortbtn-text">Severity</span>
                <span class="dir" aria-hidden="true">&darr;</span>
              </button>
            </span>
          </div>
        </div>

        {/* Shown only while the severity sort is active. "Unclassified" is the
            bottom of that order because the class is genuinely unknown, not
            because the hazard is mild, and a bare list would imply otherwise
            (docs/design.md §7). */}
        <p class="sort-note" id="sort-note" hidden>
          Unclassified rows sort last because FDA has not graded them yet &mdash;
          not because they are mild.
        </p>

        <p class="sr-only" role="status" aria-live="polite" id="sort-status"></p>

        {/* Reference detail, not a headline — but it belongs beside the count it
            qualifies rather than stranded at the bottom of the page. A source
            that went unreachable changes what "64 active" means, and a reader
            should learn that before scrolling, not after. The "last checked"
            stamp travels with it for the same reason. Set small and inline so
            three sources cost one or two lines, not five. */}
        <div class="checked">
          <span class="checked-label">Sources checked</span>

          {stamp ? (
            <span class="stamp">{stamp.day} &middot; {stamp.time} {stamp.zone}</span>
          ) : (
            <span class="stamp stamp-none">No refresh recorded yet.</span>
          )}

          {meta ? (
            <ul class="sources">
              {meta.sources.map((s) => (
                <li class:list={['src', s.reachable ? 'on' : 'off']}>
                  <span class="src-status" aria-hidden="true">{s.reachable ? '●' : '○'}</span>
                  <span class="src-name">{s.name}</span>
                  <span class="src-note">
                    {s.reachable ? `${s.count} record${s.count === 1 ? '' : 's'}` : s.note}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <span class="sources-none">
              Source reachability appears here after the first pipeline run.
            </span>
          )}
        </div>
      </header>

      <section id="list" class="list" aria-label="Active recalls">
        {recalls.length === 0 ? (
          <p class="empty">
            No records to show. If you just cloned this and are running the
            preview, run <code>npm run seed</code> or <code>npm run refresh</code>.
          </p>
        ) : (
          recalls.map((recall) => <RecallRow recall={recall} ambiguousName={isAmbiguous(recall)} />)
        )}
      </section>

      {review.length > 0 && (
        <section class="review" aria-labelledby="review-heading">
          <p class="eyebrow" id="review-heading">
            Possibly the same recall &mdash; flagged, not merged
          </p>
          <p class="review-note">
            The pipeline could not decide whether these are one recall reported
            by two agencies or two separate ones. The safer answer is to show
            both, since a wrong merge would attach the wrong lot codes to the
            wrong product.
          </p>
          {review.map((pair) => (
            <div class="pair">
              <p class="pair-why"><span class="pair-label">Flagged:</span> {pair.why}</p>
              {/* Always disambiguated: the whole claim of this section is that
                  these two might be the same recall, so the reader needs the
                  verbatim product text to judge it. */}
              {pair.records.map((recall) => <RecallRow recall={recall} ambiguousName={true} />)}
            </div>
          ))}
        </section>
      )}

      <footer class="site">
        <p class="footer-note">
          {awaitingVoice > 0 && (
            <span>{awaitingVoice} row{awaitingVoice === 1 ? '' : 's'} show the government's stated reason in place of a written summary. </span>
          )}
          Brand, product, reason and dates are the government's own words, taken
          from the page linked on every row. Class III recalls are excluded as
          the boring tier. Human food only. A <em>Public Health Alert</em> is not
          a recall &mdash; FSIS issues one when contaminated product is believed
          to be on shelves but no recall has been requested.
        </p>

        <p class="madeby">
          <a href="https://github.com/aeromax/what-the-fuck-can-i-eat" rel="noopener">
            <svg class="gh" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            <span class="gh-text">aeromax/what-the-fuck-can-i-eat</span>
          </a>
          <span class="madeby-line">Made by Max Palmer, for absolutely no reason whatsoever.</span>
        </p>
      </footer>
    </main>

    <!--
      Sorting. Deliberately small, dependency-free, and classic (not a module),
      so it runs from a file:// build as readily as from a server.

      Three properties worth keeping if this is ever edited:

        1. It REORDERS existing nodes. No row data is duplicated into JS — the
           keys are read from `data-announced` and `data-tone`, which the row
           already carries. There is one source of truth for a recall and it is
           the markup Astro rendered.
        2. It moves nodes with appendChild rather than through a fragment, so a
           node is never detached from the document. An open <details> keeps its
           `open` attribute either way, but staying attached also preserves
           focus if it happens to be inside the list.
        3. The controls start `hidden` and this script reveals them. Without
           JavaScript there are no dead buttons, and the served order is already
           the default sort, so nothing is lost.
    -->
    <script is:inline>
      (function () {
        var list = document.getElementById('list');
        var bar = document.getElementById('sort');
        var note = document.getElementById('sort-note');
        var status = document.getElementById('sort-status');
        if (!list || !bar) return;

        var rows = [];
        var kids = list.children;
        for (var i = 0; i < kids.length; i++) {
          if (kids[i].classList.contains('recall')) rows.push(kids[i]);
        }
        if (rows.length < 2) return;

        // Descending urgency. A Public Health Alert outranks a Class II on
        // purpose: it means product is believed to be in commerce with no
        // recall requested (docs/design.md section 7). Unclassified is last
        // because the grade is unknown, not because the hazard is small — the
        // note under the controls says so where a reader can see it.
        var RANK = { severe: 0, alert: 1, moderate: 2, unknown: 3 };

        // dir -1 puts the strong end first: newest dates, most urgent classes.
        var key = 'date';
        var dir = -1;

        function dateOf(el) { return el.getAttribute('data-announced') || ''; }
        function rankOf(el) {
          var r = RANK[el.getAttribute('data-tone')];
          return r === undefined ? RANK.unknown : r;
        }
        function byDateDesc(a, b) {
          var x = dateOf(a), y = dateOf(b);
          return x < y ? 1 : x > y ? -1 : 0;
        }

        function compare(a, b) {
          if (key === 'severity') {
            var d = (rankOf(a) - rankOf(b)) * (dir === -1 ? 1 : -1);
            // Within one severity group, always newest first.
            return d !== 0 ? d : byDateDesc(a, b);
          }
          return byDateDesc(a, b) * (dir === -1 ? 1 : -1);
        }

        var buttons = bar.querySelectorAll('.sortbtn');

        function label() {
          if (key === 'severity') {
            return dir === -1
              ? 'Sorted by severity, most urgent first.'
              : 'Sorted by severity, least urgent first.';
          }
          return dir === -1
            ? 'Sorted by date, newest first.'
            : 'Sorted by date, oldest first.';
        }

        function apply() {
          var sorted = rows.slice().sort(compare);
          for (var i = 0; i < sorted.length; i++) list.appendChild(sorted[i]);

          for (var j = 0; j < buttons.length; j++) {
            var active = buttons[j].getAttribute('data-sort') === key;
            buttons[j].setAttribute('aria-pressed', active ? 'true' : 'false');
            // Only the sort in force has a direction, so the idle button is
            // not left holding a stale glyph that CSS has to hide.
            var arrow = buttons[j].querySelector('.dir');
            if (arrow) arrow.textContent = !active ? '' : dir === -1 ? '\u2193' : '\u2191';
          }

          if (note) note.hidden = key !== 'severity';
          if (status) status.textContent = label();
        }

        for (var k = 0; k < buttons.length; k++) {
          buttons[k].addEventListener('click', function (e) {
            var next = e.currentTarget.getAttribute('data-sort');
            // Same sort again flips direction; a different sort starts at its
            // strong end, which is the reading almost everyone wants first.
            if (next === key) dir = -dir;
            else { key = next; dir = -1; }
            apply();
          });
        }

        bar.hidden = false;
        apply();
      })();
    </script>
  </body>
</html>

<style is:global>
  /* --- tokens ------------------------------------------------------------ */
  :root {
    --bg: #f4f1ea;
    --paper: #fbf9f3;
    --ink: #16130f;
    --dim: #6b665c;
    --rule: #d9d3c4;
    --field: #ede9dd;
    --alarm: #a4241c;
    /* Three faces, three jobs. Every stack names a real fallback: this is a
       static build with no runtime, so a blocked or failed webfont has to land
       on something deliberate rather than on Times.

       --display is CAPS-ONLY by design. Bebas Neue has no lowercase glyphs, so
       lowercase source text renders as capitals. That is the chosen look, and
       the source text stays lowercase on purpose — the aria-label, the screen
       reader, and the fallback face all depend on it. Never add
       text-transform: uppercase to "help", and never uppercase the markup.
       It also has ONE weight: hierarchy in the display face comes from size,
       colour and tracking, never font-weight, which would fake a bold. */
    --display: 'Bebas Neue', 'Arial Narrow', sans-serif;
    --serif: Lora, Georgia, serif;
    --mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12110e;
      --paper: #18161200;
      --ink: #ede8d9;
      --dim: #8a8578;
      --rule: #2b2822;
      --field: #1c1a15;
      --alarm: #e26b62;
    }
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 var(--serif);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  /* Keyboard skip-link — hidden until focused. */
  .skip {
    position: absolute; left: -9999px; top: 0;
    background: var(--ink); color: var(--bg);
    padding: 0.5rem 0.75rem; font: 600 0.85rem/1 var(--mono);
  }
  .skip:focus { left: 0.5rem; top: 0.5rem; z-index: 10; }

  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }

  /* --- masthead ---------------------------------------------------------- */
  .masthead {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0.75rem;
  }
  h1 {
    /* The signature: the title as a monospaced banner, one phrase per line.
       The type is the whole gesture — no rule, no split, nothing else to
       carry. It is the one loud element on the page.

       The scale is set by the LONGEST line, "what the fuck": 13 monospace
       characters at roughly 0.6em advance, less 13 × 0.045em of tracking, is
       about 7.2em of width. At the 11.5vw midpoint a 320px phone renders it at
       36.8px, so the line measures ~265px inside 288px of usable width. The
       previous 8.5vw / 4.25rem scale was tuned for two short stacked columns
       and is too small for a full phrase; the 4.5rem cap is reached at 626px
       and holds the line to ~518px inside the 44rem column. */
    /* Measured against Bebas, not estimated. "what the fuck" sets at 4.97em in
       this face — a condensed caps face is far narrower than the monospace
       banner this replaced, so 9k's 11.5vw / 4.5rem was much too small. At
       17.25vw a 320px phone renders 55px type and a 274px line inside 288px of
       usable width; 18vw measured 286px, which is a two-pixel margin and would
       overflow on any metric change. The 7rem cap engages at 649px and holds
       the line to 556px inside the 664px column. */
    font: clamp(3rem, 17.25vw, 7rem)/0.88 var(--display);
    /* No font-weight: Bebas has exactly one, and asking for 800 would either do
       nothing or synthesize a fake bold. Tracking is POSITIVE here — the face is
       condensed with tight defaults, the opposite of the -0.045em the previous
       monospace banner wanted. */
    letter-spacing: 0.02em;
    margin: 0;
    color: var(--ink);
  }
  .line { display: block; }
  /* Explicitly classed, never positional. A :nth-child() selector here broke
     silently in 9c when the structure changed — it reddened the wrong word and
     still compiled. Keep the accent bound to the word, not to a position. */
  .accent { color: var(--alarm); }

  /* The setup line. The list below is the punchline, so this is sized as a
     subhead rather than as body copy — big enough to be read as part of the
     title block, quiet enough not to compete with the banner above it. */
  .subhead {
    margin: 1.15rem 0 0;
    font: 400 clamp(1.25rem, 4vw, 1.75rem)/1.25 var(--serif);
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 24ch;
    text-wrap: balance;
  }

  /* The count and the sort controls share one hairline-topped strip: the count
     says how big the list is, the controls say how it is ordered. */
  .strip {
    margin: 1.15rem 0 0;
    padding-top: 1rem;
    border-top: 1px dashed var(--rule);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }
  .counts { margin: 0; padding: 0; }
  .counts > div { margin: 0; }
  .counts dt {
    font: 600 0.7rem/1.2 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 0.15rem;
  }
  .counts dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .counts strong {
    font: 600 1.4rem/1 var(--mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-right: 0.3rem;
  }

  /* --- sort controls ------------------------------------------------------ */
  /* Quiet by construction: the same mono utility face and dashed hairline as
     the strip they sit in. Only the ACTIVE sort spends the accent, and only on
     its border and label — the buttons must not compete with the banner. */
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .controls[hidden] { display: none; }
  .controls-label {
    font: 600 0.7rem/1.2 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .seg { display: flex; gap: 0.4rem; }
  .sortbtn {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    /* Comfortable on a phone without becoming a slab. */
    min-height: 2.25rem;
    padding: 0.35rem 0.7rem;
    background: none;
    border: 1px dashed var(--rule);
    border-radius: 2px;
    color: var(--dim);
    font: 400 0.8rem/1.2 var(--mono);
    letter-spacing: 0.02em;
    cursor: pointer;
  }
  .sortbtn:hover { color: var(--ink); border-color: var(--dim); }
  .sortbtn:focus-visible { outline: 2px solid var(--alarm); outline-offset: 2px; }
  .sortbtn[aria-pressed='true'] {
    border-style: solid;
    border-color: var(--alarm);
    color: var(--alarm);
    font-weight: 600;
  }
  /* The direction arrow only means anything on the sort that is actually in
     force, so the idle button does not show one. */
  .sortbtn[aria-pressed='false'] .dir { visibility: hidden; }
  .dir { font-size: 0.9em; }
  @media (prefers-reduced-motion: no-preference) {
    .sortbtn { transition: color 120ms ease, border-color 120ms ease; }
  }

  .sort-note {
    margin: 0.7rem 0 0;
    font: 400 0.85rem/1.5 var(--serif);
    font-style: italic;
    color: var(--dim);
    max-width: 40ch;
  }
  .sort-note[hidden] { display: none; }

  /* Visually hidden, still announced. */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* --- list -------------------------------------------------------------- */
  /* Recall.astro owns the row entirely — its padding, its rules, its band. The
     page deliberately sets no `.recall` rules: both stylesheets would land at
     the same specificity and whichever Astro emitted last would win, which is
     not a contract worth having. */
  .list { margin: 0; }
  .empty {
    padding: 3rem 0;
    color: var(--dim);
    font-style: italic;
    text-align: center;
