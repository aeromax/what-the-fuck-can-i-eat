---
import { formatEastern } from '../dates.ts';
import type { Recall } from '../recall.ts';
import { severityOf } from '../severity.ts';

interface Props { recall: Recall }
const { recall } = Astro.props;

// The large type is the short food name when we have one. `product` — the
// government's verbatim spec line — is then shown directly beneath it, because
// a category name must never be the only identifier on the page (docs/design.md
// §2.1, rule 1). Until step 7 generates names, displayName is null everywhere
// and the heading falls back to product, unshortened and honest.
const heading = recall.displayName ?? recall.product;
const showsSpecLine = recall.displayName !== null;

// Snark lives in headline and nowhere else. Absent until step 7.
const snark = recall.headline;

const where = recall.nationwide
  ? 'Nationwide'
  : recall.states.length > 0
    ? recall.states.join(', ')
    : null;

// Plain English instead of "Class I" — see src/severity.ts. The agency's own
// definition rides along in the title attribute so the shortening is checkable.
const severity = severityOf(recall);
const announced = formatEastern(recall.announcedDate);
const definitionTitle = severity.agency
  ? `${severity.agency}: ${severity.definition}`
  : severity.definition;
---

<article class="recall">
  <h2>{heading}</h2>

  {showsSpecLine && <p class="spec">{recall.product}</p>}
  {snark && <p class="snark">{snark}</p>}

  {recall.avoidLine
    ? <p class="avoid">{recall.avoidLine}</p>
    : <p class="avoid">
        <span class="reason">{recall.reason}</span>
        {recall.company && <span class="bit">Recalled by {recall.company}.</span>}
        {where && <span class="bit">Distributed: {where}.</span>}
        {recall.lotCodes.length > 0 && <span class="bit">Codes: {recall.lotCodes.join(' / ')}</span>}
      </p>
  }

  <p class="meta">
    <span class:list={['tag', severity.tone]} title={definitionTitle}>{severity.label}</span>
    <span class:list={['tag', recall.confidence]}>{recall.confidence}</span>
    <span class="date">{announced.text} {announced.zone}</span>
    <a href={recall.sourceUrl} rel="noopener">source</a>
  </p>
</article>

<style>
  .recall { padding: 1.75rem 0; border-bottom: 1px solid var(--rule); }
  h2 {
    font-size: clamp(1.6rem, 4.5vw, 2.4rem);
    line-height: 1.1;
    font-weight: 650;
    margin: 0 0 0.35rem;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  /* The specific thing recalled. Never omitted when the heading is a category. */
  .spec { margin: 0 0 0.6rem; font-size: 0.9rem; line-height: 1.45; color: var(--dim); }
  .snark { margin: 0 0 0.6rem; font-size: 1.05rem; }
  .avoid { margin: 0 0 0.75rem; font-size: 1rem; line-height: 1.5; color: var(--ink); }
  .reason { font-weight: 600; }
  /* No ::before spacer: compressHTML: true preserves the real whitespace between
     these spans. If someone flips that to Astro 7's 'jsx' default, the words
     glue together here first. */
  .bit { display: inline; }
  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--dim);
  }
  .tag {
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    border: 1px solid var(--rule);
    font-variant: all-small-caps;
    letter-spacing: 0.04em;
  }
  .severe { border-color: #b91c1c; color: #b91c1c; font-weight: 600; }
  .moderate { border-color: #b45309; color: #b45309; }
  .alert { border-color: #b45309; color: #b45309; font-weight: 600; }
  .unknown { border-style: dashed; }
  .verified { border-color: #15803d; color: #15803d; }
  .extracted { border-color: #a16207; color: #a16207; }
  .date { font-variant-numeric: tabular-nums; }
  a { color: var(--dim); }
</style>
