---
/**
 * One recall row, collapsible.
 *
 * Design notes (step 9a, extended 9d). Three things a hurried reader has to
 * see without reading fine print:
 *
 *  1. How serious is this?              (Class I vs Class II vs unclassified)
 *  2. How solid are the facts?          (verified vs extracted)
 *  3. Is this a recall at all, or a Public Health Alert? A PHA is not a
 *     recall — nothing has been withdrawn — and a page that labelled it as
 *     one would be stating something the government did not (design §7).
 *
 * The left band encodes 1 and 2 at once: its COLOUR is the severity tone from
 * src/severity.ts (red / amber / neutral) and its STYLE is the confidence tier
 * (solid = verified, dashed = extracted, dotted = unclassified). A PHA gets a
 * diagonal hazard-tape band instead — distinct from every recall tone at a
 * glance, without shouting louder than a Class I.
 *
 * There is NO text eyebrow. The row carried one until 2026-08-31, when it was
 * removed at the user's direction. Where each signal lives now:
 *
 *   1. severity — the plain-English label in `.glance`, on every row,
 *      collapsed, unconditionally. Never behind the toggle.
 *   2. confidence — the band's style while collapsed, and the `.tag tier`
 *      ("Verified data" / "Extracted from prose") once expanded.
 *   3. PHA — its severity label reads "Warning — not recalled, may still be on
 *      sale", which states "not a recall" in words without a second element
 *      saying it again, plus the hazard-tape band.
 *
 * The cost, recorded rather than argued: collapsed, `extracted` is signalled
 * only by a 4px dashed border. That is a visual-only channel, and it is the
 * same trade the user accepted for the `product` line in step 9f — the textual
 * provenance signal is one tap away instead of always on screen. The footer's
 * provenance paragraph still states the AI/facts boundary in prose. See
 * docs/build-plan.md step 9.
 *
 * COLLAPSED / EXPANDED (step 9d). Built on native <details>/<summary>, so it
 * works with JavaScript disabled and is keyboard-accessible without any
 * scripting or ARIA of our own.
 *
 * The collapsed summary carries four things, in this order:
 *
 *   - the item name in large type
 *   - the announcement date, as a small dateline under it
 *   - the snark headline, as an editorial aside
 *   - the plain-English severity label
 *
 * `product` moved BEHIND the toggle on 2026-08-31, at the user's explicit
 * direction. This is a deliberate relaxation of docs/design.md §2.1 rule 1,
 * which previously required `product` to be adjacent to `displayName` at all
 * times so a model-written category name could never be the sole identifier.
 * A collapsed row now identifies by `displayName` alone.
 *
 * The residual risk is real and is recorded rather than argued away: a reader
 * who never expands a row sees only a model-written category name, and "eggs"
 * can read as every egg on the shelf. What still holds is that `product` is
 * always in the DOM, always verbatim, never model-written, and one tap away —
 * so the specific thing recalled is recoverable by anyone who looks, and no
 * fact was lost. See design §2.1, "Relaxation (2026-08-31)".
 *
 * The severity label sits in the same slot on EVERY row, including the
 * "Severity not yet assigned by FDA" case. Rendering it conditionally made
 * ungraded rows read as a different kind of thing rather than as the same
 * thing pending a grade. Because that label always states the ungraded case in
 * words, there is no ungraded EYEBROW — it would have duplicated the label
 * from the slot reserved for what the label cannot say.
 *
 * Expanding adds the verbatim `product` line, the avoid-line, the confidence
 * tag and the source link.
 *
 * Contract with the page: Props is `{ recall }`. `variant` is optional and
 * only adjusts the top rule when the page wants to mark this row as one half
 * of a `data/review.json` pair — visuals remain correct when unset.
 */
import { formatEastern } from '../dates.ts';
import type { Recall } from '../recall.ts';
import { severityOf } from '../severity.ts';

interface Props {
  recall: Recall;
  variant?: 'primary' | 'reviewPair';
  /**
   * Set by the page when this row's `displayName` is NOT unique across the
   * rendered list. Five different Clover Hill cheeses are all named "cheese",
   * so without this the collapsed rows are indistinguishable — the §2.1 hazard
   * arriving in practice rather than in theory. When set, the row shows a
   * clamped extract of the verbatim `product` while collapsed, which is the
   * minimum needed to tell namesakes apart.
   */
  ambiguousName?: boolean;
}
const { recall, variant = 'primary', ambiguousName = false } = Astro.props;

const heading = recall.displayName ?? recall.product;

// The disambiguator. Only rendered when the page says this name is shared, and
// only while the row is closed — once open, the full verbatim product is right
// there in the fact list, and printing it twice is the redundancy step 9j set
// out to remove.
const showsBrief = ambiguousName && recall.displayName !== null;

// Snark lives here and nowhere else. Absent until scripts/voice.ts has run.
const snark = recall.headline;

// --- the fact list -----------------------------------------------------------
//
// The expanded body is a record, not a paragraph stack. Every value below is
// government text, verbatim, or a join of government values — nothing here is
// model-written. A field with nothing in it is OMITTED rather than printed
// empty or as "None": a blank row reads as "we checked and there is none",
// which for lot codes would be a lie.

interface Fact {
  label: string;
  value?: string;
  /**
   * Set ONLY when the record genuinely holds more than one value, in which case
   * the field renders as a numbered list of exactly these elements.
   *
   * Nothing here is ever split to manufacture entries. openFDA's `code_info` is
   * a structured field with free-text content — sometimes a bare code, sometimes
   * a whole paragraph — and splitting that prose invents lot codes that no
   * government page states (CLAUDE.md). One array element, one <li>. A single
   * long blob therefore stays a single blob, rendered as plain text.
   */
  list?: string[];
  /** Monospace the entries — right for codes, wrong for place names. */
  mono?: boolean;
  /** Verbatim government text shown under a parsed value, when the parse is
   *  best-effort and the reader deserves to see the original. */
  note?: string;
}

/** One value renders as text; several render as a list. Never splits. */
function oneOrMany(values: string[]): Pick<Fact, 'value' | 'list'> {
  if (values.length === 0) return {};
  if (values.length === 1) return { value: values[0] };
  return { list: values };
}

// `states` is a best-effort parse of free text that arrives in 21 shapes, so
// `distributionRaw` rides along when it adds something. `nationwide` wins
// outright: an empty state list on a nationwide recall is the most dangerous
// misreading available here, because it reads as "not near me".
const distributed: Pick<Fact, 'value' | 'list'> = recall.nationwide
  ? { value: 'Nationwide' }
  : recall.states.length > 0
    ? oneOrMany(recall.states)
    : recall.distributionRaw
      ? { value: recall.distributionRaw }
      : {};
const distributionNote =
  recall.distributionRaw && recall.distributionRaw !== distributed.value
    ? recall.distributionRaw
    : undefined;

// With no avoid-line, the verbatim reason takes the lead slot instead — so it
// must not also appear in the list below. Voice being absent is a normal,
// deliberate state: `npm run refresh` publishes this way without a Gemini key.
const hasAvoidLine = recall.avoidLine !== null && recall.avoidLine !== '';
const lead = hasAvoidLine ? recall.avoidLine : recall.reason;

const facts: Fact[] = [
  { label: 'Product', value: recall.product },
  { label: 'Brand', value: recall.brand },
  { label: 'Company', value: recall.company },
  hasAvoidLine ? { label: 'Reason', value: recall.reason } : { label: '' },
  { label: 'Distributed', ...distributed, note: distributionNote },
  { label: 'Retailers', ...oneOrMany(recall.retailers) },
  { label: 'Country of origin', value: recall.countryOfOrigin ?? undefined },
  { label: 'Lot codes', ...oneOrMany(recall.lotCodes), mono: true },
].filter(
  (f) => f.label !== '' && ((f.value !== undefined && f.value !== '') || (f.list?.length ?? 0) > 0),
);

// Plain English instead of "Class I" — see src/severity.ts. The agency's own
// definition rides along in the title attribute so the shortening is checkable.
const severity = severityOf(recall);
const announced = formatEastern(recall.announcedDate);
const definitionTitle = severity.agency
  ? `${severity.agency}: ${severity.definition}`
  : severity.definition;

// The row has no text eyebrow. Removed 2026-08-31 at the user's direction —
// see the note at the top of this file for what carries each signal now.

// The raw source ids are internal jargon.
const sourceLabel =
  recall.source === 'openfda'
    ? 'openFDA'
    : recall.source === 'fdaRss'
      ? 'FDA press release'
      : 'USDA FSIS';

// data-* attributes drive the band; they are the only styling hook the CSS
// needs, which keeps class-list churn out of the markup. `data-announced` is
// not styling — it is the page's sort key, read by the header's sort script so
// it never has to duplicate any record data into JavaScript.
const dataTone = severity.tone;
const dataConfidence = recall.confidence;
---

<article
  class="recall"
  data-tone={dataTone}
  data-confidence={dataConfidence}
  data-variant={variant}
  data-announced={recall.announcedDate}
>
  <details class="row">
    <summary class="head">
      <span class="head-text">
        <h2>{heading}</h2>

        {/* A dateline, sitting between the name and the joke the way a kicker
            sits under a headline. Same formatting and the same EDT/EST label
            src/dates.ts computes per date — never a fixed offset. */}
        <span class="date">{announced.text} {announced.zone}</span>

        {/* The editorial aside. A <span> and not a <p>: this sits inside the
            <summary>, where a block element would be invalid nesting — a hard
            compile error in Astro 7. Display is set to block in the CSS. */}
        {snark && <span class="snark">{snark}</span>}

        {/* Shown only when this name is shared with another row, and only while
            closed. See the `ambiguousName` prop. */}
        {showsBrief && <span class="brief">{recall.product}</span>}

        {/* Severity renders on EVERY row, unconditionally, including the 18
            ungraded ones that read "Severity not yet assigned by FDA". See the
            note at the top of this file. */}
        <span class="glance">
          <span class="tag severity" title={definitionTitle}>{severity.label}</span>
        </span>
      </span>

      <span class="chev" aria-hidden="true"></span>
    </summary>

    <div class="body">
      {/* The load-bearing sentence leads, because it is the one someone reads
          while holding the product. With no voice it is the verbatim reason
          instead, which is then omitted from the list below — each fact once.
          The list carries the identifying detail the sentence summarises, so
          nothing is stated twice at equal weight. */}
      <p class:list={['avoid', hasAvoidLine ? null : 'verbatim-lead']}>{lead}</p>

      {/* The record itself. A <dl> because these genuinely are label/value
          pairs — and because the FDA press releases this data is parsed out of
          use one too. <div> wrappers inside <dl> are valid HTML5 and keep each
          pair together for the grid. */}
      <dl class="facts">
        {facts.map((fact) => (
          <div class="fact">
            <dt>{fact.label}</dt>
            <dd>
              {fact.list
                ? <ol class:list={['multi', fact.mono ? 'mono' : null]}>
                    {fact.list.map((entry) => <li>{entry}</li>)}
                  </ol>
                : <span class:list={[fact.mono ? 'mono-value' : null]}>{fact.value}</span>}
              {fact.note && <span class="verbatim">{fact.note}</span>}
            </dd>
          </div>
        ))}
      </dl>

      <p class="meta">
        <span class="tag tier">{recall.confidence === 'verified' ? 'Verified data' : 'Extracted from prose'}</span>
        <a href={recall.sourceUrl} rel="noopener">{sourceLabel}</a>
      </p>
    </div>
  </details>
</article>

<style>
  /* Local token fallbacks live at each USE site — `var(--dim, #5b5b5b)` — and
     deliberately NOT as `--dim: var(--dim, ...)` declarations here.

     That self-referential form is a cycle: a custom property may not reference
     itself, so the declaration was invalid at computed-value time, the var()
     then resolved to nothing, `color` fell back to `inherit`, and every dim
     thing in the row rendered at full ink. It made the spec line, the date
     and the severity row exactly as dark as the heading. Found 2026-08-31 by
     reading computed styles in a browser; it is invisible to the type checker
     and to any test that does not render.

     Declaring literal values here instead would be worse: .recall is a more
     specific element than :root, so the row would then IGNORE the page's
     palette rather than defer to it.

     Consequence worth knowing: the use-site fallbacks are the LIGHT values, so
     a standalone render with no page palette stays light in both schemes. Only
     the band colours below swap on their own. In this project index.astro sets
     the dark palette on :root, which the row inherits, so the page is correct
     in both. */
  .recall {
    --band-severe:   #b91c1c;
    --band-moderate: #b45309;
    --band-unknown:  #9ca3af;
    --band-alert-a:  #b45309;
    --band-alert-b:  #fde68a;

    position: relative;
    padding-left: 1.25rem;
    border-bottom: 1px solid var(--rule, #e5e5e5);

    /* The band. Colour = severity. Style = confidence. */
    border-left: 4px solid var(--band, transparent);
  }

  /* The two halves of the encoding. Attribute selectors so the markup carries
     no redundant class list. */
  .recall[data-tone="severe"]   { --band: var(--band-severe); }
  .recall[data-tone="moderate"] { --band: var(--band-moderate); }
  .recall[data-tone="unknown"]  { --band: var(--band-unknown); }

  .recall[data-confidence="extracted"] { border-left-style: dashed; }
  .recall[data-tone="unknown"]         { border-left-style: dotted; }

  /* Public Health Alert: a diagonal hazard-tape band instead of a flat colour,
     drawn as a pseudo-element over the flat left border. A PHA is not a recall
     (design §7) and this is what makes that visible at a glance. */
  .recall[data-tone="alert"] { border-left-color: transparent; }
  .recall[data-tone="alert"]::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0;
    bottom: 0;
    width: 4px;
    background-image: repeating-linear-gradient(
      45deg,
      var(--band-alert-a) 0 6px,
      var(--band-alert-b) 6px 12px
    );
  }

  /* Review-pair marker. The page groups the two rows; this only lightens the
     top rule so the halves read as a pair rather than two separate items. */
  .recall[data-variant="reviewPair"] { border-top: 1px dashed var(--rule, #e5e5e5); }

  /* --- Disclosure ------------------------------------------------------- */

  .head {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    /* A comfortable phone target: the whole summary is the hit area, and the
       vertical padding keeps it well past 44px on the shortest possible row. */
    padding: 1.25rem 0;
    /* The summary lost the spec line, so it can now be as short as a heading
       plus one small row. This floor keeps the tap target comfortable on the
       shortest possible row without adding space to the tall ones. */
    min-height: 3.5rem;
    cursor: pointer;
    list-style: none;
  }
  /* Our own affordance replaces the default triangle, which sat at the wrong
     optical position beside 2.5rem type. */
  .head::-webkit-details-marker { display: none; }
  .head:focus-visible {
    outline: 2px solid var(--band-alert-a);
    outline-offset: 3px;
  }

  .head-text { flex: 1 1 auto; min-width: 0; }

  /* Chevron. Points down when closed, up when open. */
  .chev {
    flex: 0 0 auto;
    align-self: center;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.15rem;
    border-right: 2px solid var(--dim, #5b5b5b);
    border-bottom: 2px solid var(--dim, #5b5b5b);
    transform: rotate(45deg);
    transform-origin: center;
  }
  .row[open] .chev { transform: rotate(-135deg); }
  @media (prefers-reduced-motion: no-preference) {
    .chev { transition: transform 160ms ease; }
  }

  .body { padding-bottom: 1.5rem; }

  /* --- Summary content -------------------------------------------------- */

  h2 {
    margin: 0 0 0.3rem;
    font-size: clamp(1.7rem, 5vw, 2.5rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-wrap: balance;
    color: var(--ink, #111);
  }

  /* The dateline. Set small, uppercase and letterspaced so it reads as a
     timestamp attached to the heading rather than as a second line of it —
     the one thing it must not do is look like a subtitle. Tabular figures keep
     the dates aligned down the column while scrolling. */
  .date {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--dim, #5b5b5b);
    font-variant-numeric: tabular-nums;
  }

  /* Snark rides in italic serif so it reads as an aside, and cannot be mistaken
     for the deadpan avoid-line further down. It sits between the name and the
     spec line: the joke is a comment on the headline, and putting it after the
     spec would make it read as a comment on the pack sizes. The spec line still
     follows immediately, so the name is never the reader's only identifier. */
  .snark {
    display: block;
    margin-bottom: 0.5rem;
    font-family: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--ink, #111);
    max-width: 54ch;
  }

  /* Severity. Rendered on every row, in this slot, unconditionally — including
     "Severity not yet assigned by FDA". The date used to share this row and now
     sits under the heading, but the container stays: it is the slot, and a
     second collapsed tag would belong here rather than anywhere new. */
  .glance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--dim, #5b5b5b);
  }

  /* --- Body content ----------------------------------------------------- */

  /* The collapsed disambiguator. Two lines of the verbatim product, enough to
     tell "cheese" from "cheese" without putting a ten-line openFDA spec string
     under every heading. It disappears when the row opens, because the full
     untruncated text is then in the fact list below. */
  .brief {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--dim, #5b5b5b);
  }
  .row[open] .brief { display: none; }

  /* The load-bearing sentence. The line someone reads while holding the
     product, so it is the largest thing in the body. */
  .avoid {
    margin: 0 0 0.9rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--ink, #111);
    max-width: 60ch;
  }
  /* No avoid-line: the lead is verbatim government text instead of a written
     sentence, and is marked as quoted so the difference is visible rather than
     silently passed off as the same kind of line. */
  .avoid.verbatim-lead {
    padding-left: 0.85rem;
    border-left: 2px solid var(--rule, #e5e5e5);
    font-weight: 600;
  }

  /* --- the fact list ----------------------------------------------------- */

  .facts {
    margin: 0 0 1rem;
    display: grid;
    gap: 0.55rem;
  }
  .fact {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.25rem 1rem;
    align-items: baseline;
  }
  .fact dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--dim, #5b5b5b);
  }
  .fact dd {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink, #111);
    /* Government product text runs long and unbroken; never let it push the
       page sideways. */
    overflow-wrap: anywhere;
  }
  /* The government's own words under a best-effort parse of them. */
  .verbatim {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8rem;
    color: var(--dim, #5b5b5b);
  }
  /* A multi-value field is a numbered reference list: quiet, countable, and
     honest about how many values the record actually holds. The count comes
     from the array, never from splitting a string. */
  .multi {
    margin: 0;
    padding-left: 1.6rem;
  }
  .multi li {
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .multi li + li { margin-top: 0.15rem; }
  /* Numbers quiet and aligned, matching the dateline's tabular figures. */
  .multi li::marker {
    color: var(--dim, #5b5b5b);
    font-size: 0.8em;
    font-variant-numeric: tabular-nums;
  }
  .multi.mono li,
  .mono-value {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
  }

  /* Stack the label above the value where 8.5rem of gutter would squeeze the
     text into a column two words wide. */
  @media (max-width: 30rem) {
    .fact { grid-template-columns: 1fr; gap: 0.1rem; }
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--dim, #5b5b5b);
  }

  /* --- Shared atoms ----------------------------------------------------- */

  .tag {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--rule, #e5e5e5);
    border-radius: 2px;
    font-variant: all-small-caps;
    letter-spacing: 0.04em;
    line-height: 1.4;
    /* nowrap suits the short tier tag ("Verified data"). The severity label is
       a whole sentence and overrides it below. */
    white-space: nowrap;
  }
  /* The severity label is a sentence, not a chip: "Can cause temporary or
     reversible illness" is 301px of unbreakable text, which on a 320px phone
     pushed the whole PAGE sideways — every row, not just the tag. Found
     2026-08-31 while checking the retitled masthead for overflow. Let it wrap. */
  .tag.severity {
    white-space: normal;
    text-wrap: balance;
  }

  /* The severity tag borrows the band colour, so the two signals agree. */
  .recall[data-tone="severe"]   .tag.severity { border-color: var(--band-severe);   color: var(--band-severe);   font-weight: 700; }
  .recall[data-tone="moderate"] .tag.severity { border-color: var(--band-moderate); color: var(--band-moderate); }
  .recall[data-tone="alert"]    .tag.severity { border-color: var(--band-alert-a);  color: var(--band-alert-a);  font-weight: 700; }
  .recall[data-tone="unknown"]  .tag.severity { border-style: dashed; }

  .recall[data-confidence="extracted"] .tag.tier { border-style: dashed; }

  a { color: var(--dim, #5b5b5b); text-decoration: underline; text-underline-offset: 2px; }
  a:hover { color: var(--ink, #111); }
  a:focus-visible { outline: 2px solid var(--band-alert-a); outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) {
    a { transition: color 120ms ease; }
  }

  /* Dark mode. Only tokens swap; layout is untouched. Band colours are nudged
     lighter so they hold contrast on a dark ground without going neon. */
  @media (prefers-color-scheme: dark) {
    .recall {
      --band-severe:   #f87171;
      --band-moderate: #fbbf24;
      --band-unknown:  #6b7280;
      --band-alert-a:  #fbbf24;
      --band-alert-b:  #78350f;
    }
  }
</style>
